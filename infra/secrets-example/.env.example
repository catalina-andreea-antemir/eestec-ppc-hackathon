# Variable names for .env (repo root). NO values: scripts/start.sh / scripts/start.ps1 generate
# .env with random values if it is missing (and append any new variables). .env is ignored by Git.
# SQL passwords satisfy the SQL Server policy (CHECK_POLICY = ON): at least 8 chars, upper, lower and digits.

# SQL Server (mssql, mssql-init)
MSSQL_SA_PASSWORD=
META_DB_PASSWORD=
STORAGE_DB_PASSWORD=
# Optional split profile (ADR-001): STORAGE_DB_HOST=mssql-storage. Empty STORAGE_DB_SA_PASSWORD = same sa password.
# Do not set STORAGE_DB_SA_PASSWORD when STORAGE_DB_HOST=mssql (init.sh would use it for mssql).
STORAGE_DB_HOST=
STORAGE_DB_SA_PASSWORD=

# MinIO (root account and the app user created by minio-init)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# FTP
FTP_USER=
FTP_PASSWORD=

# Grafana (F7): admin password, anonymous access disabled
GRAFANA_ADMIN_PASSWORD=

# Keys: JWT (HMAC, base64), AES-256-GCM for CONNECTION_DOC (32 bytes, base64), HMAC for signed links
JWT_SECRET=
DOC_ENCRYPTION_KEY=
DOWNLOAD_LINK_SECRET=

# Test users, one per role (dispecer=DISPATCH, teren=FIELD, racordari=CONNECTIONS,
# contor=METER_SERVICE, admin=ADMIN)
FILEGRID_USER_DISPECER_PASSWORD=
FILEGRID_USER_TEREN_PASSWORD=
FILEGRID_USER_RACORDARI_PASSWORD=
FILEGRID_USER_CONTOR_PASSWORD=
FILEGRID_USER_ADMIN_PASSWORD=
