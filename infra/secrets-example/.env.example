# Numele variabilelor din .env (radacina repo-ului). FARA valori: scripts/start.sh / scripts/start.ps1 genereaza
# .env cu valori aleatorii daca lipseste (si adauga variabilele noi care lipsesc). .env este ignorat de Git.
# Parolele SQL respecta politica SQL Server (CHECK_POLICY = ON): minim 8 caractere, litere mari, mici si cifre.

# SQL Server (mssql, mssql-init)
MSSQL_SA_PASSWORD=
META_DB_PASSWORD=
STORAGE_DB_PASSWORD=
# Optional, profilul split (ADR-001): STORAGE_DB_HOST=mssql-storage. STORAGE_DB_SA_PASSWORD gol = aceeasi parola sa.
# Nu seta STORAGE_DB_SA_PASSWORD cand STORAGE_DB_HOST=mssql (init.sh l-ar folosi pentru mssql).
STORAGE_DB_HOST=
STORAGE_DB_SA_PASSWORD=

# MinIO (contul root si utilizatorul aplicatiei, creat de minio-init)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# FTP
FTP_USER=
FTP_PASSWORD=

# Grafana (F7): parola contului admin, acces anonim dezactivat
GRAFANA_ADMIN_PASSWORD=

# Chei: JWT (HMAC, base64), AES-256-GCM pentru CONNECTION_DOC (32 de octeti, base64), HMAC pentru link-urile semnate
JWT_SECRET=
DOC_ENCRYPTION_KEY=
DOWNLOAD_LINK_SECRET=

# Utilizatorii de test, unul per rol (dispecer=DISPATCH, teren=FIELD, racordari=CONNECTIONS,
# contor=METER_SERVICE, admin=ADMIN)
FILEGRID_USER_DISPECER_PASSWORD=
FILEGRID_USER_TEREN_PASSWORD=
FILEGRID_USER_RACORDARI_PASSWORD=
FILEGRID_USER_CONTOR_PASSWORD=
FILEGRID_USER_ADMIN_PASSWORD=
