<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>

    <appender name="API_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- No separate active file: each path stays stable across rollover, even while Promtail is stopped. -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>/var/log/filegrid/api-${HOSTNAME}.%d{yyyy-MM-dd,UTC}.%i.log</fileNamePattern>
            <maxFileSize>${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-8MB}</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>64MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>logstash</format>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="API_JSON"/>
    </root>
</configuration>
