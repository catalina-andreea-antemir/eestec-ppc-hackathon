    {
      "type": "timeseries",
      "title": "Citiri trimise vs. confirmate",
      "description": "sim_readings_sent_total vs. sim_readings_confirmed_total (citiri/s). Diferă mereu cu loturile în curs; alerta 1 nu le compară direct.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(sim_readings_sent_total[$__rate_interval]))",
          "legendFormat": "trimise",
          "range": true,
          "instant": false,
          "editorMode": "code"
